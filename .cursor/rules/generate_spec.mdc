## Mocking and Stubbing

### Repository Patterns
```ruby
# Simple mocking (repository standard)
allow_any_instance_of(API::V1::UsersController).to receive(:current_user).and_return(user)

# WebMock for external services (configured globally)
# WebMock.disable_net_connect! is already configured in rails_helper
```

### Best Practice Patterns (For New Specs)
```ruby
# Using instance_double (preferred for new specs)
let(:service) { instance_double(SomeService) }

# Stubbing methods
before do
  allow(service).to receive(:process).and_return(true)
end

# Expecting calls
expect(service).to have_received(:process).with(user)
```

## Common Matchers

### Repository-Specific Matchers
- HTTP Status: `expect(response).to have_http_status(:success)`
- JSON Response: `expect(json[:user][:id]).to eq(user.id)`
- Record Changes: `expect { action }.to change(User, :count).by(1)`
- Shoulda Matchers: `it { is_expected.to validate_presence_of(:email) }`
- Uniqueness: `it { is_expected.to validate_uniqueness_of(:email).case_insensitive }`

### Standard Matchers
- Equality: `expect(actual).to eq(expected)`
- Truthiness: `expect(actual).to be_truthy` / `expect(actual).to be_falsey`
- Presence: `expect(actual).to be_present`
- Errors: `expect { action }.to raise_error(ErrorClass)`
- Change: `expect { action }.to change { object.value }.from(old).to(new)`

## Example Specs

### Model Spec (Repository Pattern)
```ruby
# frozen_string_literal: true

  describe 'validations' do
    subject { build(:user) }

    # Classification: High Importance
    # Type: Happy Path
    # Scenario: Email presence validation
    # Impact: Data integrity
    it { is_expected.to validate_presence_of(:email) }
    
    # Classification: High Importance
    # Type: Edge Case
    # Scenario: Email uniqueness validation
    # Impact: Data integrity
    it { is_expected.to validate_uniqueness_of(:email).case_insensitive.scoped_to(:provider) }

    # Classification: High Importance
    # Type: Edge Case
    # Scenario: UID uniqueness validation
    # Impact: Data integrity
    it { is_expected.to validate_uniqueness_of(:uid).scoped_to(:provider) }
  end

  describe '#full_name' do
    context 'when user has first_name and last_name' do
      let(:user) { create(:user, first_name: 'John', last_name: 'Doe') }

      # Classification: Low Importance
      # Type: Happy Path
      # Scenario: Full name concatenation with names
      # Impact: Data presentation
      it 'returns the concatenated name' do
        expect(user.full_name).to eq('John Doe')
      end
    end

    context 'when user only has username' do
      let(:user) { create(:user, first_name: '', last_name: '', username: 'johndoe') }

      # Classification: Low Importance
      # Type: Happy Path
      # Scenario: Full name fallback to username
      # Impact: Data presentation
      it 'returns the username' do
        expect(user.full_name).to eq('johndoe')
      end
    end
  end

  describe '.from_social_provider' do
    let(:provider) { 'google' }
    let(:params) { { 'id' => 'user@example.com', 'email' => 'user@example.com' } }

    context 'when user does not exist' do
      # Classification: High Importance
      # Type: Happy Path
      # Scenario: Creating user from social provider
      # Impact: User authentication functionality
      it 'creates a new user' do
        expect {
          described_class.from_social_provider(provider, params)
        }.to change(described_class, :count).by(1)
      end
    end

    context 'when user already exists' do
      let!(:existing_user) { create(:user, provider: provider, uid: 'user@example.com') }

      # Classification: High Importance
      # Type: Edge Case
      # Scenario: Finding existing social provider user
      # Impact: User authentication functionality
      it 'returns the existing user' do
        result = described_class.from_social_provider(provider, params)
        expect(result).to eq(existing_user)
      end
    end
  end
end
```

### API Controller Spec (Repository Pattern with User Context)
```ruby
# frozen_string_literal: true

describe 'API::V1::UsersController' do
  # User context setup - CRITICAL for auth_headers to work
  let(:user) { create(:user) }
  let(:other_user) { create(:user) }

  describe 'GET /api/v1/users/:id' do
    subject { get api_v1_user_path, headers: auth_headers }

    it_behaves_like 'there must not be a Set-Cookie in Header'

    # Classification: High Importance
    # Type: Happy Path
    # Scenario: Authenticated user viewing their profile
    # Impact: Core API functionality with user context
    it 'returns success' do
      subject
      expect(response).to have_http_status(:success)
    end

    # Classification: High Importance
    # Type: Happy Path
    # Scenario: Returning user data for authenticated user
    # Impact: API data delivery with user context
    it 'returns the logged in user data' do
      subject
      expect(json[:user][:id]).to eq(user.id)
      expect(json[:user][:email]).to eq(user.email)
      expect(json[:user][:name]).to eq(user.full_name)
    end

    context 'when user is not authenticated' do
      subject { get api_v1_user_path }  # No auth headers

      # Classification: High Importance
      # Type: Edge Case
      # Scenario: Unauthenticated access attempt
      # Impact: API security
      it 'returns unauthorized status' do
        subject
        expect(response).to have_http_status(:unauthorized)
      end
    end

    context 'when record is not found' do
      # Classification: High Importance
      # Type: Edge Case
      # Scenario: User record not found for authenticated user
      # Impact: API error handling with user context
      it 'returns not found status' do
        allow_any_instance_of(API::V1::UsersController).to receive(:current_user)
          .and_raise(ActiveRecord::RecordNotFound)
        subject
        expect(response).to have_http_status(:not_found)
      end
    end
  end

  describe 'PUT /api/v1/users/:id' do
    subject { put api_v1_user_path, params: { user: user_params }, headers: auth_headers }

    let(:user_params) { { first_name: 'Updated', last_name: 'Name' } }

    # Classification: High Importance
    # Type: Happy Path
    # Scenario: Authenticated user updating their profile
    # Impact: Core business functionality with user context
    it 'updates the user' do
      subject
      expect(response).to have_http_status(:success)
      expect(user.reload.first_name).to eq('Updated')
      expect(user.reload.last_name).to eq('Name')
    end

    context 'with different user types' do
      context 'when user is admin' do
        let(:user) { create(:user, :admin) }  # Assuming admin trait exists

        # Classification: High Importance
        # Type: Happy Path
        # Scenario: Admin user updating their profile
        # Impact: Authorization with user context
        it 'allows profile update' do
          subject
          expect(response).to have_http_status(:success)
        end
      end

      context 'when user is regular user' do
        let(:user) { create(:user) }

        # Classification: High Importance
        # Type: Happy Path
        # Scenario: Regular user updating their own profile
        # Impact: Authorization with user context
        it 'allows own profile update' do
          subject
          expect(response).to have_http_status(:success)
        end
      end
    end

    context 'with invalid params' do
      let(:user_params) { { email: 'invalid-email' } }

      # Classification: High Importance
      # Type: Edge Case
      # Scenario: Authenticated user with invalid user data
      # Impact: Data validation with user context
      it 'returns validation errors' do
        subject
        expect(response).to have_http_status(:unprocessable_entity)
      end
    end
  end

  describe 'POST /api/v1/users' do
    subject { post '/api/v1/users', params: { user: user_params }, headers: auth_headers }

    let(:user_params) { { email: 'new@example.com', password: 'password123' } }

    context 'when user is admin' do
      let(:user) { create(:user, :admin) }

      # Classification: High Importance
      # Type: Happy Path
      # Scenario: Admin user creating new user
      # Impact: User management functionality with admin context
      it 'creates a new user' do
        expect { subject }.to change(User, :count).by(1)
        expect(response).to have_http_status(:created)
      end
    end

    context 'when user is regular user' do
      let(:user) { create(:user) }

      # Classification: High Importance
      # Type: Edge Case
      # Scenario: Regular user attempting to create user
      # Impact: Authorization security with user context
      it 'may restrict user creation based on permissions' do
        subject
        # Adjust expectation based on your authorization rules
        expect(response).to have_http_status(:forbidden)  # or :created if allowed
      end
    end
  end

  describe 'DELETE /api/v1/users/:id' do
    subject { delete "/api/v1/users/#{target_user.id}", headers: auth_headers }

    let(:target_user) { create(:user) }

    context 'when user is admin' do
      let(:user) { create(:user, :admin) }

      # Classification: High Importance
      # Type: Happy Path
      # Scenario: Admin user deleting another user
      # Impact: User management functionality with admin context
      it 'deletes the user' do
        target_user # ensure user exists
        expect { subject }.to change(User, :count).by(-1)
        expect(response).to have_http_status(:no_content)
      end
    end

    context 'when user tries to delete themselves' do
      let(:target_user) { user }

      # Classification: High Importance
      # Type: Edge Case
      # Scenario: User attempting to delete their own account
      # Impact: Account safety with user context
      it 'may prevent self-deletion' do
        subject
        # Adjust expectation based on your business rules
        expect(response).to have_http_status(:forbidden)  # or :no_content if allowed
      end
    end
  end
end
```

### Policy Spec (Repository Pattern)
```ruby
# frozen_string_literal: true

describe UserPolicy do
  subject { described_class }

  let(:user1) { create(:user) }
  let(:user2) { create(:user) }

  permissions :update? do
    # Classification: High Importance
    # Type: Edge Case
    # Scenario: User updating different user
    # Impact: Authorization security
    it 'denies access if user is not the same' do
      expect(subject).not_to permit(user1, user2)
    end

    # Classification: High Importance
    # Type: Happy Path
    # Scenario: User updating themselves
    # Impact: Authorization functionality
    it 'allow access if user is the same' do
      expect(subject).to permit(user1, user1)
    end
  end
end
```

